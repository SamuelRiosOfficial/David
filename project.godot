; Engine configuration file.
; DAVID — El pastor, el rey, el amado de Dios

config_version=5

[application]

config/name="DAVID — El pastor, el rey, el amado de Dios"
run/main_scene="res://scenes/menus/main_menu.tscn"
config/features=PackedStringArray("4.0", "GL Compatibility")
config/description="Videojuego bíblico 2D: el primer capítulo de la historia de David."

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.0352941, 0.0470588, 0.0588235, 1)
